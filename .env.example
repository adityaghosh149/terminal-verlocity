# ==============================================================================
# TERMINAL VELOCITY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), add these environment variables in project settings.

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# MongoDB connection string with credentials and database name.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/terminal_velocity?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/terminal_velocity?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. Custom Authentication & Cryptography
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret for signing short-lived JWT access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="terminal_velocity_super_secret_jwt_access_signing_key_min_32_chars"

# Issuer and audience for JWT claims verification
JWT_ISSUER="terminal-velocity.app"
JWT_AUDIENCE="terminal-velocity-players"

# ------------------------------------------------------------------------------
# 3. Application & Deployment URLs
# ------------------------------------------------------------------------------
# Base URL of the application (used for email verification & password reset links)
# Local: http://localhost:3000 | Production: https://your-deployment.vercel.app
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Transactional Email Service (Resend)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com
# In local development without an API key, OTPs and reset tokens are safely logged
# to the server console in dev mode so you can test all auth flows immediately!
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="Terminal Velocity <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 5. Environment & Rate Limiting
# ------------------------------------------------------------------------------
NODE_ENV="development"
