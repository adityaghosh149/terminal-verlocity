# ==============================================================================
# TERMINAL VELOCITY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), add these environment variables in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Connection string with credentials and database name.
# Ensure Network Access in MongoDB Atlas allows Vercel (0.0.0.0/0).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/terminal_velocity?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. Custom Authentication & Session Secrets
# ------------------------------------------------------------------------------
# 32+ character high-entropy secrets for signing JWT access and refresh tokens.
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your_custom_jwt_access_secret_key_at_least_32_characters_long"
JWT_REFRESH_SECRET="your_custom_jwt_refresh_secret_key_at_least_32_characters_long"

# ------------------------------------------------------------------------------
# 3. JWT Token Expirations
# ------------------------------------------------------------------------------
# Formats accepted: "15m" (15 minutes), "1h" (1 hour), "30d" (30 days), etc.
# Access tokens should be short-lived; refresh tokens provide persistent login.
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ------------------------------------------------------------------------------
# 4. JWT Claims Verification
# ------------------------------------------------------------------------------
JWT_ISSUER="terminal-velocity.app"
JWT_AUDIENCE="terminal-velocity-players"
